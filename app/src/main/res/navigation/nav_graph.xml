<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- ── HOME ─────────────────────────── -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.quizpulse_navigation.ui.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_quizFragment"
            app:destination="@id/quizFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_homeFragment_to_aboutFragment"
            app:destination="@id/aboutFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_homeFragment_to_rulesFragment"
            app:destination="@id/rulesFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ── QUIZ (receives SafeArgs) ─────── -->
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.example.quizpulse_navigation.ui.quiz.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz">

        <!-- SafeArgs argument -->
        <argument
            android:name="categoryName"
            app:argType="string" />

        <action
            android:id="@+id/action_quizFragment_to_quizWonFragment"
            app:destination="@id/quizWonFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_quizFragment_to_quizFailedFragment"
            app:destination="@id/quizFailedFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ── QUIZ WON (2 SafeArgs) ─────────── -->
    <fragment
        android:id="@+id/quizWonFragment"
        android:name="com.example.quizpulse_navigation.ui.result.QuizWonFragment"
        android:label="@string/title_won"
        tools:layout="@layout/fragment_quiz_won">

        <argument android:name="score" app:argType="integer" />
        <argument android:name="total" app:argType="integer" />

        <!-- popUpToInclusive=true → clears back stack including Home -->
        <action
            android:id="@+id/action_quizWonFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ── QUIZ FAILED ───────────────────── -->
    <fragment
        android:id="@+id/quizFailedFragment"
        android:name="com.example.quizpulse_navigation.ui.result.QuizFailedFragment"
        android:label="@string/title_failed"
        tools:layout="@layout/fragment_quiz_failed">

        <action
            android:id="@+id/action_quizFailedFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ── ABOUT (Options Menu) ──────────── -->
    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.quizpulse_navigation.ui.info.AboutFragment"
        android:label="@string/about_title"
        tools:layout="@layout/fragment_about" />

    <!-- ── RULES (Navigation Drawer) ────── -->
    <fragment
        android:id="@+id/rulesFragment"
        android:name="com.example.quizpulse_navigation.ui.info.RulesFragment"
        android:label="@string/rules_title"
        tools:layout="@layout/fragment_rules" />

</navigation>
