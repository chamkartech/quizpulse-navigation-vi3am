<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/primaryContainer" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape>
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</selector>
